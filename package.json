{
  "name": "my-tab",
  "version": "1.0.0",
  "private": true,
  "description": "MyTab — 一键收起标签页的浏览器扩展（Vue 3 + TypeScript + Composition API + Manifest V3）",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "tsx scripts/make-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dnd": "node scripts/check-dnd.mjs",
    "check:library": "node scripts/check-library.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:selection": "node scripts/check-selection.mjs",
    "demo": "tsx scripts/make-demo-page.ts && tsx scripts/make-ui-harness.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "qrcode-generator": "^1.4.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
